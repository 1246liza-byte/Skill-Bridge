# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/skillsbridge

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRE=30d

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Cloudinary (optional - for image uploads in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional - for password reset / contact replies)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Initial Admin (used by createAdmin script)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@skillsbridge.com
ADMIN_PASSWORD=Admin@12345